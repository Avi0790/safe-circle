# Client-safe Supabase credentials for the mobile app and the web
# dashboard. Get these from Project Settings -> API once the backend is
# linked (`supabase link`) and the migrations are pushed. Safe to embed in a client
# bundle — access control is enforced by row-level security, not by hiding
# these values.

# Mobile app (Expo)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Web dashboard (Vite) - rename the prefix if the web app uses a different
# bundler convention.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where the web dashboard is deployed (mobile-only) — guest tracking links
# point at this URL's /track/<token> page. Leave unset locally; it falls
# back to http://localhost:5173 for local dev.
EXPO_PUBLIC_WEB_URL=https://<your-project>.vercel.app

# Optional: directions use free public OpenStreetMap services by default (OSRM
# for routes, Photon for place search). Those are shared community servers, fine
# for a demo but not for production traffic; point these at your own instances.
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# EXPO_PUBLIC_GEOCODER_URL=https://photon.komoot.io

# Web dashboard: "Pay by card" through Stripe on the Plan tab. Leave unset
# (demo billing only) until the server has its Stripe keys; see
# backend/README.md "Stripe billing (test mode)".
VITE_STRIPE_BILLING=
